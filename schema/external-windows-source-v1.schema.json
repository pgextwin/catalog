{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pgextwin external Windows binary candidate registry, metadata and authority kept separate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedDate",
    "sourceInventory",
    "trust",
    "publicationAuthorized",
    "redistributionAuthorized",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pgextwin-windows-source-candidates/v1"
    },
    "observedDate": {
      "type": "string",
      "format": "date"
    },
    "sourceInventory": {
      "enum": [
        "evidence/issue112-external-release-inventory-20261103.json",
        "evidence/issue112-external-provider-portalcorp-20261103.json"
      ]
    },
    "trust": {
      "const": "UNVERIFIED_METADATA_ONLY"
    },
    "publicationAuthorized": {
      "const": false
    },
    "redistributionAuthorized": {
      "const": false
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "extension",
          "upstreamVersion",
          "pgMajor",
          "architecture",
          "pgDistribution",
          "abi",
          "buildMethod",
          "sourceGroup",
          "providerType",
          "provider",
          "sourceRepo",
          "sourceCommitSha",
          "releaseTag",
          "assetVersion",
          "releaseId",
          "assetId",
          "assetName",
          "assetUrl",
          "apiDigest",
          "originalSha256",
          "license",
          "dependencies",
          "lifecycle",
          "historical",
          "acquisitionState",
          "verificationState",
          "compatibilityVerified",
          "dependenciesVerified",
          "rightsReviewed",
          "provenanceVerified",
          "downloadAuthorized",
          "redistributionAuthorization",
          "discoveredAt"
        ],
        "properties": {
          "extension": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "upstreamVersion": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"
          },
          "pgMajor": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"
          },
          "architecture": {
            "enum": [
              "x86",
              "x64"
            ]
          },
          "pgDistribution": {
            "enum": [
              "standard-postgresql",
              "vendor-postgresql",
              "conda-postgresql",
              "unknown"
            ]
          },
          "abi": {
            "type": "string",
            "minLength": 1
          },
          "buildMethod": {
            "const": "external"
          },
          "sourceGroup": {
            "const": "external"
          },
          "providerType": {
            "enum": [
              "upstream-official",
              "community",
              "vendor",
              "package-manager"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "sourceRepo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "sourceCommitSha": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "releaseTag": {
            "type": "string",
            "minLength": 1
          },
          "assetVersion": {
            "type": "string",
            "minLength": 1
          },
          "releaseId": {
            "type": "integer",
            "minimum": 1
          },
          "assetId": {
            "type": "integer",
            "minimum": 1
          },
          "assetName": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._+-]+$"
          },
          "assetUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/"
          },
          "apiDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "originalSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycle": {
            "enum": [
              "supported",
              "eol"
            ]
          },
          "historical": {
            "type": "boolean"
          },
          "acquisitionState": {
            "enum": [
              "public-metadata",
              "missing",
              "removed",
              "blocked"
            ]
          },
          "verificationState": {
            "enum": [
              "metadata-only",
              "verified",
              "rejected"
            ]
          },
          "compatibilityVerified": {
            "type": "boolean"
          },
          "dependenciesVerified": {
            "type": "boolean"
          },
          "rightsReviewed": {
            "type": "boolean"
          },
          "provenanceVerified": {
            "type": "boolean"
          },
          "downloadAuthorized": {
            "type": "boolean"
          },
          "redistributionAuthorization": {
            "enum": [
              "not-authorized",
              "approved",
              "denied"
            ]
          },
          "discoveredAt": {
            "type": "string",
            "format": "date"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verificationState": {
                  "const": "metadata-only"
                }
              },
              "required": [
                "verificationState"
              ]
            },
            "then": {
              "properties": {
                "downloadAuthorized": {
                  "const": false
                },
                "redistributionAuthorization": {
                  "const": "not-authorized"
                },
                "originalSha256": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "downloadAuthorized": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "verificationState": {
                  "const": "verified"
                },
                "originalSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "compatibilityVerified": {
                  "const": true
                },
                "dependenciesVerified": {
                  "const": true
                },
                "rightsReviewed": {
                  "const": true
                },
                "provenanceVerified": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  }
}
