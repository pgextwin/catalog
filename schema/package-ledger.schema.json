{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/catalog/schema/package-ledger.schema.json",
  "title": "pgextwin package ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "displayName",
    "description",
    "repository",
    "license",
    "architecture",
    "runtime",
    "capabilities",
    "capabilitiesSource",
    "schemaVersion",
    "upstream",
    "repositoryId",
    "latestReleaseId",
    "unavailableMajors",
    "releases"
  ],
  "properties": {
    "name": {
      "$ref": "extension.schema.json#/properties/name"
    },
    "displayName": {
      "$ref": "extension.schema.json#/properties/displayName"
    },
    "description": {
      "$ref": "extension.schema.json#/properties/description"
    },
    "repository": {
      "$ref": "extension.schema.json#/properties/repository"
    },
    "license": {
      "$ref": "extension.schema.json#/properties/license"
    },
    "architecture": {
      "$ref": "extension.schema.json#/properties/architecture"
    },
    "runtime": {
      "$ref": "extension.schema.json#/properties/runtime"
    },
    "capabilities": {
      "$ref": "extension.schema.json#/properties/capabilities"
    },
    "capabilitiesSource": {
      "$ref": "extension.schema.json#/properties/capabilitiesSource"
    },
    "externalSourceRegistry": {
      "$ref": "extension.schema.json#/properties/externalSourceRegistry"
    },
    "schemaVersion": {
      "const": 1
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "$ref": "extension.schema.json#/properties/upstream/properties/repository"
        },
        "versionScheme": {
          "const": "perPostgresql"
        },
        "unpublishedByMajor": {
          "$ref": "extension.schema.json#/properties/upstream/properties/perPostgresql"
        }
      }
    },
    "repositoryId": {
      "$ref": "#/$defs/githubId"
    },
    "latestReleaseId": {
      "$ref": "#/$defs/githubId"
    },
    "unavailableMajors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]?$"
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "githubId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTag",
        "releaseId",
        "packages"
      ],
      "properties": {
        "releaseTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
        },
        "releaseId": {
          "$ref": "#/$defs/githubId"
        },
        "publishedAt": {
          "$ref": "extension.schema.json#/properties/latest/properties/publishedAt"
        },
        "checksumsAsset": {
          "$ref": "extension.schema.json#/properties/latest/properties/checksumsAsset"
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalogCommit"
          ],
          "properties": {
            "catalogCommit": {
              "$ref": "#/$defs/commit"
            }
          }
        },
        "legacyInventoryCommit": {
          "$ref": "#/$defs/commit"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/package"
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pgMajor",
        "version",
        "asset",
        "assetId",
        "sha256",
        "license"
      ],
      "properties": {
        "pgMajor": {
          "type": "string",
          "pattern": "^[1-9][0-9]?$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
        },
        "assetId": {
          "$ref": "#/$defs/githubId"
        },
        "sha256": {
          "$ref": "extension.schema.json#/$defs/sha256"
        },
        "license": {
          "$ref": "extension.schema.json#/$defs/packageLicense"
        },
        "upstreamRef": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "extension.schema.json#/$defs/supplyChainEvidence"
        }
      }
    }
  }
}
