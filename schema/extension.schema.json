{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/catalog/schema/extension.schema.json",
  "title": "pgextwin catalog extension record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "description",
    "upstream",
    "repository",
    "license",
    "architecture",
    "latest",
    "postgresql",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "perPostgresql": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "version"
          ],
          "not": {
            "required": [
              "perPostgresql"
            ]
          }
        },
        {
          "required": [
            "perPostgresql"
          ],
          "not": {
            "required": [
              "version"
            ]
          }
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^pgextwin/[A-Za-z0-9_.-]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "const": "x64"
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTag"
      ],
      "properties": {
        "releaseTag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgresql": {
      "type": "object",
      "description": "Published and verified binary availability by PostgreSQL major. This is historical availability metadata, not current PostgreSQL community maintenance status.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "available"
        ],
        "properties": {
          "available": {
            "type": "boolean",
            "description": "True when a published and verified Windows x64 binary asset exists for this PostgreSQL major. This does not indicate whether the PostgreSQL major is currently maintained."
          },
          "asset": {
            "type": "string",
            "description": "Published release asset filename for this PostgreSQL major when recorded."
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sharedPreloadLibraries"
      ],
      "properties": {
        "sharedPreloadLibraries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
