{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/catalog/schema/extension.schema.json",
  "title": "pgextwin catalog extension record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "description",
    "upstream",
    "repository",
    "license",
    "architecture",
    "latest",
    "postgresql",
    "runtime",
    "capabilities",
    "capabilitiesSource"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "perPostgresql": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "version"
          ],
          "not": {
            "required": [
              "perPostgresql"
            ]
          }
        },
        {
          "required": [
            "perPostgresql"
          ],
          "not": {
            "required": [
              "version"
            ]
          }
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^pgextwin/[A-Za-z0-9_.-]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "const": "x64"
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTag",
        "publishedAt",
        "releaseUrl",
        "checksumsAsset"
      ],
      "properties": {
        "releaseTag": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releaseUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "checksumsAsset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._+-]+$"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "description": "Published and verified binary availability by PostgreSQL major. Historical availability is intentionally separate from current PostgreSQL lifecycle/maintenance state.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/postgresqlBinary"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sharedPreloadLibraries",
        "requirements"
      ],
      "properties": {
        "sharedPreloadLibraries": {
          "type": "array",
          "uniqueItems": true,
          "description": "Legacy compatibility field retained for existing consumers. Canonical runtime requirement semantics are in runtime.requirements.preload.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "$ref": "#/$defs/runtimeRequirements"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testContractVersion",
        "coverage",
        "functionalScenarios"
      ],
      "properties": {
        "testContractVersion": {
          "const": 2
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "functionalScenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/functionalScenario"
          }
        }
      }
    },
    "capabilitiesSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^pgextwin/[A-Za-z0-9_.-]+$"
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "downloadUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "asset",
              "downloadUrl",
              "sha256"
            ]
          }
        }
      ]
    },
    "attestationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        }
      }
    },
    "supplyChainEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildProvenanceAttestation",
        "sbom",
        "sbomAttestation",
        "vulnerabilityReport"
      ],
      "properties": {
        "buildProvenanceAttestation": {
          "$ref": "#/$defs/attestationEvidence"
        },
        "sbom": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "sbomAttestation": {
          "$ref": "#/$defs/attestationEvidence"
        },
        "vulnerabilityReport": {
          "$ref": "#/$defs/artifactEvidence"
        }
      }
    },
    "postgresqlBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean",
          "description": "True when a published and verified Windows x64 binary asset exists for this PostgreSQL major. This does not indicate whether the PostgreSQL major is currently maintained."
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "downloadUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "$ref": "#/$defs/supplyChainEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "asset",
              "downloadUrl",
              "sha256",
              "evidence"
            ]
          }
        }
      ]
    },
    "runtimeRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extensionCreation",
        "preload",
        "backgroundWorker",
        "clientExecutable"
      ],
      "properties": {
        "extensionCreation": {
          "enum": [
            "required",
            "optional",
            "not-required",
            "unknown"
          ]
        },
        "preload": {
          "enum": [
            "none",
            "shared",
            "session",
            "either",
            "optional",
            "unknown"
          ]
        },
        "backgroundWorker": {
          "type": "boolean"
        },
        "clientExecutable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "packagePaths"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "packagePaths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/repositoryRelativePath"
              }
            }
          }
        }
      }
    },
    "coverageStatus": {
      "enum": [
        "covered",
        "not-covered",
        "not-applicable"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createExtension",
        "backgroundWorker",
        "clientExecutable",
        "serverLogAssertions",
        "upgrade"
      ],
      "properties": {
        "createExtension": {
          "$ref": "#/$defs/coverageStatus"
        },
        "backgroundWorker": {
          "$ref": "#/$defs/coverageStatus"
        },
        "clientExecutable": {
          "$ref": "#/$defs/coverageStatus"
        },
        "serverLogAssertions": {
          "$ref": "#/$defs/coverageStatus"
        },
        "upgrade": {
          "$ref": "#/$defs/coverageStatus"
        }
      }
    },
    "functionalScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sql-result",
              "query-plan",
              "server-log",
              "background-worker-side-effect",
              "client-executable",
              "physical-storage",
              "logical-decoding",
              "extension-upgrade",
              "backup-restore"
            ]
          }
        },
        "postgresqlMajors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 99
          }
        }
      }
    }
  }
}
