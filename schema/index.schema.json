{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgextwin.github.io/catalog/schema/index.schema.json",
  "title": "pgextwin catalog index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    }
  }
}
