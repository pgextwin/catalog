{
  "schemaVersion": "pgextwin-external-discovery-providers/v1",
  "trust": "READ_ONLY_METADATA_NEVER_AUTHORIZE",
  "githubApiHost": "api.github.com",
  "providers": [
    {
      "repo": "laurenz/oracle_fdw",
      "providerType": "upstream-official",
      "extension": "oracle_fdw",
      "assetPattern": "^oracle_fdw-[0-9]+(?:\\.[0-9]+){1,2}-pg[0-9]+(?:\\.[0-9]+)?-win(?:32|64)\\.zip$"
    },
    {
      "repo": "HypoPG/hypopg",
      "providerType": "upstream-official",
      "extension": "hypopg",
      "assetPattern": "^hypopg-[0-9]+(?:\\.[0-9]+){1,2}-pg[0-9]+(?:\\.[0-9]+)?-x64\\.(?:zip|exe)$"
    },
    {
      "repo": "andreiramani/pgvector_pgsql_windows",
      "providerType": "community",
      "extension": "pgvector",
      "assetPattern": "^vector\\.v[0-9]+(?:\\.[0-9]+){2}-pg[0-9]+(?:\\.[0-9]+)?\\.zip$"
    },
    {
      "repo": "trickle-labs/pg-trickle",
      "providerType": "upstream-official",
      "extension": "pg_trickle",
      "assetPattern": "^pg_trickle-[0-9]+(?:\\.[0-9]+){2}-pg18-windows-amd64\\.zip$"
    },
    {
      "repo": "HiraokaHyperTools/pg_bigm",
      "providerType": "community",
      "extension": "pg_bigm",
      "assetPattern": "^[0-9]{8}\\.7z$"
    },
    {
      "repo": "pgroonga/pgroonga",
      "providerType": "upstream-official",
      "extension": "pgroonga",
      "assetPattern": "^pgroonga-[0-9]+(?:\\.[0-9]+){1,3}-postgresql-(?:14|15|16|17|18)-x64\\.zip$"
    },
    {
      "repo": "timescale/timescaledb",
      "providerType": "upstream-official",
      "extension": "timescaledb",
      "assetPattern": "^timescaledb-postgresql-(?:14|15|16|17|18)-windows-amd64\\.zip$"
    },
    {
      "repo": "portalcorp/pgvector_compiled",
      "providerType": "community",
      "extension": "pgvector",
      "assetPattern": "^pgvector-(?:x86_64-pc-windows-msvc|Windows)-pg16\\.zip$"
    }
  ]
}
