      "backgroundWorker": false,
      "clientExecutable": {
        "required": false,
        "packagePaths": []
      }
    }
  },
  "capabilities": {
    "testContractVersion": 2,
    "coverage": {
      "createExtension": "covered",
      "backgroundWorker": "not-applicable",
      "clientExecutable": "not-applicable",
      "serverLogAssertions": "not-covered",
      "upgrade": "not-covered"
    },
    "functionalScenarios": [
      {
        "id": "detect-invalid-record-field",
        "description": "Diagnoses a missing record field on an empty-table loop without executing the function, then verifies the diagnostic disappears after a correction.",
        "evidence": [
          "sql-result"
        ]
      }
    ]
  },
