    "functionalScenarios": [
      {
        "id": "permission-target-and-diffs",
        "description": "Creates pg_permissions, records desired privileges in public.permission_target, grants partial privileges, and verifies public.permission_diffs() detects both missing and extra grants.",
        "evidence": [
          "sql-result"
        ]
      },
      {
        "id": "permission-views-reflect-grants",
        "description": "Verifies public.schema_permissions and public.table_permissions reflect granted and ungranted privileges accurately.",
        "evidence": [
          "sql-result"
        ]
      }
    ]
  },
