          "sql-result"
        ]
      },
      {
        "id": "track-setting-change-diff-and-log",
        "description": "Changes work_mem between two snapshots and verifies pg_track_settings_log() and pg_track_settings_diff() report the recorded change accurately.",
        "evidence": [
          "sql-result"
        ]
      }
    ]
